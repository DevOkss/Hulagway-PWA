# Optional. The PWA reads VITE_API_URL in src/services/api.ts and falls back
# to /api (relative) — Vercel rewrites /api/* to the production backend in
# vercel.json, so no CORS issues and no absolute URL needed in source code.
#
# For laptop development only, copy this file to `.env.development.local`
# (gitignored, dev-mode only, never deployed) and uncomment:
# VITE_API_URL=http://localhost:8001/api
#
# Do NOT hardcode a localhost URL in src/services/api.ts — a phone's
# "localhost" is the phone itself, so the deployed PWA would fail every
# API call (login/sync/submit) with a Network Error. Do NOT use a plain
# `.env.local` for this — that file also loads during `npm run build` and
# would bake localhost into production bundles.
